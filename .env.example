# Copier ce fichier en .env pour le développement local (jamais commité).
# Sur Vercel : Project Settings > Environment Variables (mêmes noms).

# Resend (secrets, serveur uniquement)
RESEND_API_KEY=
CONTACT_TO_EMAIL=
CONTACT_FROM_EMAIL=

# Supabase (secrets, serveur uniquement : runtimeConfig privé, jamais NUXT_PUBLIC_)
NUXT_SUPABASE_URL=
NUXT_SUPABASE_SERVICE_ROLE_KEY=

# Publiques : URL du site et coordonnées affichées (Contact, Mentions légales, Confidentialité)
NUXT_PUBLIC_SITE_URL=
NUXT_PUBLIC_CONTACT_EMAIL=
NUXT_PUBLIC_CONTACT_PHONE=
NUXT_PUBLIC_CONTACT_LOCATION=
# Numéro WhatsApp au format international (ex. 221XXXXXXXXX) : lien « Écrire sur WhatsApp »
NUXT_PUBLIC_CONTACT_WHATSAPP=
